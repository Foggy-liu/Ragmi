# 环境变量
.env
.env.local

# IDE配置
.idea/
.vscode/

# Python缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# 虚拟环境
venv/
env/
.venv/

# 大文件
documents/*.pdf
documents/*.docx
documents/img/

# 向量数据库
chroma_db/
*.db
*.sqlite*

# 临时文件
utils/docs/manager/*.txt
utils/docs/process/*.txt
*.log
*.tmp

# 系统文件
.DS_Store
Thumbs.db

# 整个 docs/ 是私人参考文档（本地保留阅读，不上传仓），但 plan/ 与 status/ 是流程产物与现状快照
docs/*
!docs/README.md
!docs/plan/
!docs/plan/**
!docs/status/
!docs/status/**

# txt/ 和 documents/ 内容不上传（运行时生成/用户文件），但空目录本身是程序必需的
txt/*
!txt/.gitkeep
documents/*
!documents/.gitkeep

# Claude 工具链配置与本地会话记忆（不是项目代码）
.claude/
memory/
# RULE.md 是本地协作规则（由两个 memory 文件夹整合而来），不上传仓
RULE.md

# Docker volumes 数据（Milvus/etcd/minio 持久化数据）
volumes/

# Git worktree 本地工作区
.worktrees/

# understand-anything 工具生成的中间产物（可重新生成）
.understand-anything/

# Test fixtures (runtime test data) —— 只放行 sample.txt（被 plan 文档的 curl 上传命令引用）
test/fixtures/*
!test/fixtures/sample.txt

# E2E 运行产物（截图 + 报告），本地看就行，不进仓
test/e2e/_artifacts/
