# 阿里云配置
ALIYUN_API_KEY=your_api_key_here
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL_NAME=qwen-plus

# 项目根目录（请修改为你的实际路径）
LLM_ROOT=D:\\your\\path\\to\\ragmi

# 向量数据库存储路径
VECTOR_STORE_PATH=D:\\your\\path\\to\\ragmi\\data

# ===== LangSmith（v2.1 新增）=====
# 自动 trace 所有 LangChain / LangGraph 调用
LANGSMITH_TRACING=true
# 项目名: LangSmith 仪表盘里的分组
LANGSMITH_PROJECT=ragmi-agent-v2
# API key: 从 https://smith.langchain.com 注册账号拿
LANGSMITH_API_KEY=<your-langsmith-api-key>
