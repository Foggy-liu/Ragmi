# ===== LLM (MiniMax) =====
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_API_KEY=<your_key_here>

# ===== LLM (Aliyun 备选) =====
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_API_KEY=<your_key_here>

# ===== Ollama (本地 embedding) =====
# 末尾的 /v1：embedding 端会剥掉它（走 Ollama 原生 /api/embed），
#             ollama 平台的 chat 走 OpenAI 兼容端点，需要保留 /v1
# 容器内用 host.docker.internal（解析到宿主机），裸跑时改成 http://127.0.0.1:11434/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# ===== Milvus =====
# compose 内用 milvus（service 名），裸跑用 localhost
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=langchain

# ===== LangSmith（可选） =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=<your_key_here>
LANGSMITH_PROJECT=ragmi

# ===== Embedding =====
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-large
EMBEDDING_DIM=1024
